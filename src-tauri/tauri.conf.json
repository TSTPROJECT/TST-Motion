{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TST Motion",
  "mainBinaryName": "TST Motion",
  "version": "0.5.5",
  "identifier": "app.tstmotion.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TST Motion",
        "width": 1366,
        "height": 820,
        "minWidth": 360,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' blob: data: ipc: http://ipc.localhost https://huggingface.co https://*.huggingface.co https://*.hf.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TST Motion",
    "category": "GraphicsAndDesign",
    "shortDescription": "Free 2D motion animation",
    "longDescription": "Free, open-source 2D motion animation for cut-out characters and motion graphics. Thai and English.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tstm"],
        "name": "TST Motion project",
        "description": "TST Motion project",
        "role": "Editor",
        "mimeType": "application/zip"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Thai", "English"],
        "customLanguageFiles": { "Thai": "nsis/Thai.nsh" },
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
